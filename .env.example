# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY / VITE_YOUTUBE_API_KEY: YouTube Data API v3 key for YouTube video search, live streams, statistics, comments, and channels.
YOUTUBE_API_KEY="AIzaSyB--gyG9wfGMhFvaQg2HICAGuyZ5h2JNBE"
VITE_YOUTUBE_API_KEY="AIzaSyB--gyG9wfGMhFvaQg2HICAGuyZ5h2JNBE"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: OAuth 2.0 Web Application credentials
# Required for connecting a user's official YouTube account and uploading videos via YouTube Data API v3.
# Authorized Redirect URI in Google Cloud Console must be: ${APP_URL}/api/youtube/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AUTH_SECRET: Persistent HMAC secret used for hashing session tokens and signing auth artifacts.
# Set a fixed random value in production so active sessions survive container rebuilds and restarts.
AUTH_SECRET=""

# DATA_DIR / PROD_DATA_DIR / DEV_DATA_DIR: Optional persistent data directories for dev/prod isolation.
# Mount a persistent volume or set DATA_DIR to keep database, backups, and uploaded media across deployments.
DATA_DIR=""
PROD_DATA_DIR=""
DEV_DATA_DIR=""

# OWNER_SECRET: Secret key required to claim the founder/owner badge via /api/auth/claim-owner.
OWNER_SECRET=""

# OBJECT_STORAGE_PROVIDER: Optional external object storage provider identifier (e.g., supabase_s3, local_persistent).
OBJECT_STORAGE_PROVIDER=""

# ==========================================
# PRODUCTION PERSISTENCE: SUPABASE POSTGRESQL (SESSION POOLER)
# ==========================================
# DB_DRIVER: "postgres" | "json" | "" (auto: uses postgres when DATABASE_URL is set, otherwise json)
DB_DRIVER=""

# DATABASE_URL: Supabase PostgreSQL Session Pooler URI (IPv4-compatible, port 5432)
# Example format (NEVER commit real passwords):
# postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_DB_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# PG_POOL_MAX / PGSSLMODE: Optional PostgreSQL connection pool tuning
PG_POOL_MAX="10"
PGSSLMODE="require"

# ==========================================
# PRODUCTION MEDIA STORAGE: SUPABASE PRIVATE S3 BUCKET
# ==========================================
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Supabase S3-compatible endpoint, region, bucket & access keys
# Endpoint example: https://<PROJECT_REF>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_REGION="ap-northeast-1"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_BUCKET="motherland-media"

# MEDIA_STORAGE_MODE: "s3" | "disk" | "" (auto: uses supabase_s3 when S3 env vars are set)
MEDIA_STORAGE_MODE=""
