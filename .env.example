# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY / VITE_YOUTUBE_API_KEY: YouTube Data API v3 key for YouTube video search, live streams, statistics, comments, and channels.
YOUTUBE_API_KEY="AIzaSyB--gyG9wfGMhFvaQg2HICAGuyZ5h2JNBE"
VITE_YOUTUBE_API_KEY="AIzaSyB--gyG9wfGMhFvaQg2HICAGuyZ5h2JNBE"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: OAuth 2.0 Web Application credentials
# Required for connecting a user's official YouTube account and uploading videos via YouTube Data API v3.
# Authorized Redirect URI in Google Cloud Console must be: ${APP_URL}/api/youtube/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AUTH_SECRET: Persistent HMAC secret used for hashing session tokens and signing auth artifacts.
# Set a fixed random value in production so active sessions survive container rebuilds and restarts.
AUTH_SECRET=""

# DATA_DIR / PROD_DATA_DIR / DEV_DATA_DIR: Optional persistent data directories for dev/prod isolation.
# Mount a persistent volume or set DATA_DIR to keep database, backups, and uploaded media across deployments.
DATA_DIR=""
PROD_DATA_DIR=""
DEV_DATA_DIR=""

# OWNER_SECRET: Secret key required to claim the founder/owner badge via /api/auth/claim-owner.
OWNER_SECRET=""

# OBJECT_STORAGE_PROVIDER: Optional external object storage provider identifier (e.g., gcs, s3).
OBJECT_STORAGE_PROVIDER=""

